#!/bin/sh

. "$(chezmoi target-path)/.czhelpers"

echo ''

{{ if eq .chezmoi.os "darwin" -}}

package_install "vivid"

{{ else if eq .chezmoi.os "linux" -}}

if ! [ -x "$(command -v "vivid")" ]; then
	info "📦 Installing vivid"
	tmproot=${TMPDIR:-${TEMP:-${TMP:-/tmp}}}
	cd "$tmproot"

	filename="vivid_0.10.1_amd64.deb"
	wget "https://github.com/sharkdp/vivid/releases/download/v0.10.1/${filename}"
	sudo dpkg -i "${filename}"

	rm "$filename"
	success "vivid"
else
	skip "vivid"
fi

{{ end -}}

echo ''
