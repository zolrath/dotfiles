#!/bin/sh

. "$(chezmoi target-path)/.czhelpers"

echo ''

{{ if eq .chezmoi.os "linux" -}}

# If we're in WSL
{{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}

if ! [ -x "$(command -v wezterm.exe)" ]; then
    info '💻 Installing wezterm'
    winget.exe install wez.wezterm
    success 'wezterm'
else
    skip 'wezterm'
fi

# wezterm.lua hash: {{ include "dot_config/wezterm/wezterm.lua" | sha256sum }}
info '💻 Copying wezterm config to Windows'
win_user=$(/mnt/c/Windows/System32/cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r')
mkdir -p "/mnt/c/Users/${win_user}/.config/wezterm/" && cp ~/.local/share/chezmoi/dot_config/wezterm/wezterm.lua "/mnt/c/Users/${win_user}/.config/wezterm/"
success 'copied wezterm config'

# Otherwise we're in normal linux
{{   else -}}

if ! [ -x "$(command -v wezterm)" ]; then
    info '💻 Installing wezterm'
    cd /tmp
    curl -LO https://github.com/wez/wezterm/releases/download/nightly/wezterm-nightly.Ubuntu22.04.deb
    sudo apt install -y ./wezterm-nightly.Ubuntu22.04.deb
    success 'wezterm'
else
    skip 'wezterm'
fi

{{   end -}}

{{ end -}}

echo ''
