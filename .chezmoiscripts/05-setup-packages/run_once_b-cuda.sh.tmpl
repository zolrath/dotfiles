#!/bin/bash

. "$(chezmoi target-path)/.czhelpers"

echo ''

{{ if eq .chezmoi.os "linux" -}}
  # If we're in WSL
  {{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}

  # ── CUDA network repo setup ──
  if ! [ -f /usr/share/keyrings/cuda-archive-keyring.gpg ]; then
      info '📁 Setting up CUDA network repo'

      tmproot=${TMPDIR:-${TEMP:-${TMP:-/tmp}}}
      cd "$tmproot"

      wget https://developer.download.nvidia.com/compute/cuda/repos/wsl-ubuntu/x86_64/cuda-wsl-ubuntu.pin
      sudo mv cuda-wsl-ubuntu.pin /etc/apt/preferences.d/cuda-repository-pin-600

      wget https://developer.download.nvidia.com/compute/cuda/repos/wsl-ubuntu/x86_64/cuda-keyring_1.1-1_all.deb
      sudo dpkg -i cuda-keyring_1.1-1_all.deb
      rm -f cuda-keyring_1.1-1_all.deb

      sudo apt-get update
      success 'CUDA network repo'
  else
      skip 'CUDA network repo'
  fi

  # ── CUDA toolkit ──
  if ! [ -x "$(command -v nvcc)" ]; then
      info '📁 Installing CUDA toolkit'
      sudo apt-get -y install cuda-toolkit
      success 'CUDA toolkit'
  else
      skip 'CUDA toolkit'
  fi

  # ── cuDNN ──
  if ! dpkg -s libcudnn9-cuda-12 >/dev/null 2>&1 || ! dpkg -s libcudnn9-cuda-13 >/dev/null 2>&1; then
      info '🧠 Installing cuDNN'
      sudo apt-get -y install libcudnn9-cuda-12 libcudnn9-dev-cuda-12 libcudnn9-cuda-13 libcudnn9-dev-cuda-13
      success 'cuDNN'
  else
      skip 'cuDNN'
  fi

  # ── NVIDIA Container Toolkit ──
  if ! [ -x "$(command -v nvidia-container-runtime)" ]; then
      info '🐳 Installing NVIDIA Container Toolkit'
      sudo apt-get -y install nvidia-container-toolkit
      success 'NVIDIA Container Toolkit'
  else
      skip 'NVIDIA Container Toolkit'
  fi

  {{ end -}}
{{ end -}}

echo ''
