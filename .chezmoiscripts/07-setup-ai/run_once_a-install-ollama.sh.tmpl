#!/bin/sh

. "$(chezmoi target-path)/.czhelpers"

echo ''

{{ if eq .chezmoi.os "darwin" -}}

brew_cask_install "ollama"

{{ else if eq .chezmoi.os "linux" -}}

if ! [ -x "$(command -v ollama)" ]; then
	info '🤖 Installing ollama'
	curl -fsSL https://ollama.com/install.sh | sh
	success 'ollama'
else
	skip 'ollama'
fi

{{ end -}}

echo ''
